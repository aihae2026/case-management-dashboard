# 환경변수 목록 (값은 직접 발급해서 채웁니다. 실제 값이 들어 있는 .env 는 커밋하지 마세요)

# ── 웹앱 (Vercel 환경변수 / 로컬은 .env.local) ─────────────────────
# Supabase 프로젝트 주소와 공개(publishable) 키 — 브라우저에 노출되어도 되는 값
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 서버 쪽에서 쓰는 같은 값
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 서비스 키 — 절대 브라우저/저장소에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=
# 슈퍼 관리자 이메일(쉼표로 구분). 서버에서만 읽으며 비어 있으면 아무도 슈퍼 관리자가 아니다
SUPER_ADMIN_EMAILS=
# 기관별 기본 담당자 설정(JSON, 선택) — 형식은 src/lib/worker-defaults.ts 참고
VITE_DEFAULT_WORKER_CONFIG=
# 우리 기관 이름(개인정보 처리방침·기관 목록·삭제 보호 기관에 사용). 서버 쪽에서도 같은 값을 읽으므로 ORG_NAME 으로도 등록해도 됩니다
VITE_ORG_NAME=
# 이 서비스의 배포 주소(공유 미리보기 og 태그에 사용, 선택). 비우면 https://example.com 이 쓰입니다
VITE_SITE_URL=
# 네이버 지도(선택)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ── Supabase Edge Function 시크릿 (Dashboard > Edge Functions > Secrets) ──
# 서버 함수 호출을 허용할 웹앱 주소(쉼표로 구분). 비우면 localhost만 허용되어 서버 함수 호출이 막히므로 반드시 본인 배포 주소로 지정하세요
ALLOWED_ORIGINS=
# AI (Gemini)
GEMINI_API_KEY=
# 기본 모델 이름은 코드에 기본값이 있고, 바꾸려면 아래를 지정합니다(선택)
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
# 자원 배분 도우미만 따로 모델을 지정할 때(선택, off 로 끄기)와 응답 대기 시간 조정(선택)
GEMINI_MODEL_RESOURCE=
GEMINI_OVERRIDE_TIMEOUT_MS=
GEMINI_MAX_RETRY_WAIT_MS=
# Google Drive 중계(Apps Script) 연결
DRIVE_UPLOAD_URL=
DRIVE_SECRET=
# (참고) Google Drive 백업은 여기가 아니라 Apps Script 스크립트 속성(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY)으로 설정합니다
# 말벗 챗봇 연동(선택)
COMPANION_SUPABASE_URL=
COMPANION_SUPABASE_ANON_KEY=
# 서버 전용 서비스 키 — 복순이 연동 시 필수(모니터링 조회·삭제에 사용). 절대 공개 금지
COMPANION_SUPABASE_SERVICE_ROLE_KEY=
COMPANION_MONITOR_SECRET=

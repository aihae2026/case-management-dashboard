# 이 파일을 복사해서 .env.local 로 이름 바꾼 뒤 값을 채우세요.
# .env.local 은 git에 올라가지 않으므로 새 컴퓨터에서는 직접 만들어야 합니다.

# ── 복순이 Supabase (<프로젝트 ID>) ─────────────────────────────────
# Supabase 대시보드 → 프로젝트 선택 → Settings → API → service_role 키
SUPABASE_SERVICE_ROLE_KEY=""

# ── Gemini AI ─────────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ── 통합사례관리 연동 (ai-case-management 프로젝트) ─────────────────────────
# CASE_LOOKUP_URL: 통합사례관리 Supabase REST URL (https://<프로젝트 ID>.supabase.co)
CASE_LOOKUP_URL=""
# CASE_LOOKUP_ANON_KEY: 통합사례관리 Supabase anon 키
#   → Supabase 대시보드 → Settings → API → anon key
CASE_LOOKUP_ANON_KEY=""
# CASE_LOOKUP_SECRET: 복순이↔통합사례관리 공유 시크릿 (통합사례관리 담당자에게 확인)
CASE_LOOKUP_SECRET=""
# CASE_SERVICE_ROLE_KEY: 통합사례관리 service_role 키. 담당 복지사 전화번호를 읽는 데만 쓰고 서버 전용
#   (없으면 담당자 이름만 저장되고 번호는 비워진다)
CASE_SERVICE_ROLE_KEY=""

# ── 통합사례관리 대시보드 → 복순이 모니터링 API 인증 ────────────────────────
# 통합사례관리 앱이 /api/public/companion/analysis 를 호출할 때 쓰는 키
# 길고 무작위인 문자열을 새로 만들어 양쪽에 같은 값으로 설정
COMPANION_API_KEY=""

# ── 관리자·담당자 표시 ───────────────────────────────────────────────────────
# ADMIN_EMAILS: /admin 에 들어갈 수 있는 관리자 구글 계정 (쉼표로 구분)
ADMIN_EMAILS=""
# 로그인 화면·채팅 화면에 보이는 담당자 (비우면 "담당 사회복지사"로 표시)
STAFF_LEE_NAME=""
STAFF_LEE_PHONE=""
STAFF_LEE_TITLE=""
STAFF_BAEK_NAME=""
STAFF_BAEK_PHONE=""
STAFF_BAEK_TITLE=""

# 이용 횟수 제한 (Upstash Redis) - 선택사항
# 채팅·음성 안내·생년월일 확인에 적용된다. 없으면 제한이 꺼진다 (서비스는 정상 작동, 단 남용 방어 없음)
# https://console.upstash.com 에서 Redis DB 생성 후 값 입력 (Vercel KV를 쓰면 KV_REST_API_URL/TOKEN도 인식)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 참고: 백업 Edge Function의 비밀값(DRIVE_UPLOAD_URL, DRIVE_SECRET, BACKUP_SECRET)은
# 이 파일이 아니라 Supabase 대시보드의 함수 Secrets에 넣는다.

# 우리 기관 이름(개인정보 처리방침에 표시)
VITE_ORG_NAME=""
